# Visual-regression baseline images (9 MB). The manifest is committed so drift is detectable by
# hash; regenerate the images locally with: node scripts/visual-check.mjs --capture
qa/baseline/*.png

# Test artefacts
qa/diff/
qa/tmp/
*.log

# Mobile audit output (screenshots + JSON). Regenerate with: node scripts/mobile-audit.mjs
qa/mobile/
qa/audit-out.txt
qa/matrix.txt

# M9.2 inspection output. Regenerate with:
#   node scripts/inspect-shots.mjs   (page screenshots, portrait + landscape)
#   node scripts/inspect-region.mjs  (single band at full resolution)
#   node scripts/inspect-modal.mjs   (dialogs)
#   node scripts/a11y-check.mjs      (axe + manual checks)
qa/inspect/
qa/m10/
qa/audit/
qa/*.txt

# Ad-hoc debugging scripts written while investigating a specific defect. Anything worth keeping
# belongs in scripts/ with a name that says what it proves.
qa/*.mjs

# The previous accepted visual baseline (commit 69c9a63). Its manifest is committed so the two
# baselines can be compared by hash; the images are regenerated on demand — see DESIGN-LOCK 17.4.
qa/baseline-previous/*.png
qa/prev/

# Screenshots taken during a review. Never part of the deliverable.
qa/shots/
qa/baseline-release/*.png

# Screenshots from the visual acceptance sweep. Regenerated with scripts/eyeball.mjs.
qa/eyeball/

# Control census written by scripts/exhaustive-controls-check.mjs.
qa/control-census.json

# scratch probes (an underscore prefix means a one-off, not a suite)
scripts/_*.mjs
qa/audit-results/
